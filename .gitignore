# Downloaded toolchains and test scratch. The Go tarball is 67 MB of
# upstream binary that any build can re-fetch, and a.txt is a curl cookie
# jar left by an API test -- a session artifact, never source.
go*.linux-amd64.tar.gz
a.txt
cookies*.txt
